# Aapki Grocery — pretty URL rewrites (Apache mod_rewrite)
#
# This file works BOTH on:
#   • localhost in a subfolder (http://localhost/aapkigrocery/)
#   • a live domain at root (https://aapkigrocery.com/)
# because it does NOT hardcode a RewriteBase — the %{REQUEST_URI} based
# RewriteBase is auto-detected and targets are resolved relative to this
# .htaccess directory.

<IfModule mod_rewrite.c>
RewriteEngine On

# Auto-detect the base path (works in a subfolder or at the domain root).
RewriteCond %{REQUEST_URI}::$0 ^(/.+?)/(.*)::\2$
RewriteRule ^(.*)$ - [E=BASE:%1]

# Serve existing files and directories (account/, admin/, api/, assets/, product/, uploads/) directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Static CMS pages -> page.php?slug=...   (MUST come before the generic category rule)
RewriteRule ^(about-us|privacy-policy|terms-and-conditions|faqs|contact-us|farmers-connect)/?$ page.php?slug=$1 [L,QSA]

# Cart & checkout
RewriteRule ^cart/?$ cart.php [L,QSA]

# Product detail: /category-slug/product-slug/
RewriteRule ^([a-z0-9-]+)/([a-z0-9-]+)/?$ product/index.php?cat=$1&slug=$2 [L,QSA]

# Category listing: /category-slug/
RewriteRule ^([a-z0-9-]+)/?$ index.php?cat=$1 [L,QSA]
</IfModule>
