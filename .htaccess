# Aapki Grocery — pretty URL rewrites (Apache mod_rewrite)
#
# Works both on localhost in a subfolder (http://localhost/aapkigrocery/)
# and on a live domain at root (https://aapkigrocery.com/).
# No hardcoded RewriteBase — Apache resolves rule targets relative to this
# .htaccess directory.

<IfModule mod_rewrite.c>
RewriteEngine On

# ── 1. Never rewrite real application directories ───────────────
# These are served directly (account/, admin/, api/, product/, assets/,
# uploads/, auth/, config/, includes/, lib/, tools/, database/).
RewriteRule ^(account|admin|api|product|assets|uploads|auth|config|includes|lib|tools|database)(/|$) - [L]

# ── 2. Never rewrite any request that maps to a real file or dir ─
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── 3. Static CMS pages -> page.php?slug=...  (before category rule) ──
RewriteRule ^(about-us|privacy-policy|terms-and-conditions|faqs|contact-us|farmers-connect)/?$ page.php?slug=$1 [L,QSA]

# ── 4. Cart & checkout ──
RewriteRule ^cart/?$ cart.php [L,QSA]

# ── 5. Product detail: /category-slug/product-slug/ ──
RewriteRule ^([a-z0-9-]+)/([a-z0-9-]+)/?$ product/index.php?cat=$1&slug=$2 [L,QSA]

# ── 6. Category listing: /category-slug/ ──
RewriteRule ^([a-z0-9-]+)/?$ index.php?cat=$1 [L,QSA]
</IfModule>
